# LM Studio OpenAI-compatible endpoint
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=qwen/qwen3.5-9b
RIKU_WORKSPACE_ROOT=

# Telegram: create/rotate this with BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling

# Local storage. Replace with shared services for a production deployment.
MASTRA_DATABASE_URL=file:./architect.db
MASTRA_TELEMETRY_DISABLED=1

# Authenticated local workspace (Node 24 recommended)
RIKU_HOST=127.0.0.1
RIKU_PORT=4120
RIKU_DATA_DIR=.runtime/platform
# Set an explicit revision whenever model weights/configuration change.
RIKU_MODEL_REVISION=local-v1
# Optional embeddings model, served by the same OpenAI-compatible endpoint.
LM_STUDIO_EMBEDDING_MODEL=
# Required for production or non-loopback serving:
RIKU_TLS_CERT=
RIKU_TLS_KEY=
RIKU_PUBLIC_URL=
# Optional secret-manager override: base64-encoded 32-byte master key.
# On Windows, the automatic local key is protected with the current user's DPAPI.
RIKU_MASTER_KEY=

# Optional Telegram access allowlist (comma-separated numeric user IDs)
TELEGRAM_ALLOWED_USER_IDS=
