{
  "name": "riku-ai",
  "version": "3.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tsx src/platform/server.ts",
    "build": "mastra build && node scripts/build-platform.mjs",
    "start": "node dist/platform/server.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "demo": "tsx src/cli.ts demo",
    "analyse": "tsx src/cli.ts analyse",
    "doctor": "tsx src/cli.ts doctor",
    "benchmark": "tsx src/cli.ts benchmark",
    "review": "tsx src/cli.ts review",
    "test": "tsx --test tests/*.test.ts",
    "studio": "mastra dev",
    "studio:start": "mastra start",
    "build:workspace": "node scripts/build-platform.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.25",
    "@chat-adapter/telegram": "^4.36.0",
    "@mastra/core": "^1.57.0",
    "@mastra/libsql": "^1.19.0",
    "@mastra/memory": "^1.26.0",
    "ai": "^7.0.55",
    "dotenv": "^17.4.2",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "otpauth": "^9.6.0",
    "pdf-lib": "^1.17.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "latest",
    "esbuild": "^0.28.2",
    "mastra": "^1.23.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
