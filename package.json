{
  "name": "requora-ai",
  "version": "1.0.0",
  "private": true,
  "description": "ReQuora AI — Agentic E-Commerce Requirements Engineering, SDLC Selection & IEEE 830-1998 SRS Generator",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "app": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "mastra:dev": "mastra dev",
    "mastra:build": "mastra build",
    "build": "tsc --noEmit && mastra build",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/requora/self-check.ts",
    "check": "npm run typecheck && npm test && npm run mastra:build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.25",
    "@chat-adapter/telegram": "^4.36.0",
    "@mastra/core": "^1.57.0",
    "@mastra/libsql": "^1.19.0",
    "@mastra/memory": "^1.26.0",
    "ai": "^7.0.55",
    "dotenv": "^17.4.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "latest",
    "mastra": "^1.23.0",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3"
  }
}
